{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "scripts"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@workspace/pokemmo-damage-calc",
    "build": "npm run build --workspace=@workspace/pokemmo-damage-calc",
    "typecheck:libs": "tsc --build",
    "typecheck": "tsc -b",
    "lint": "tsc -b --noEmit"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.3"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "@esbuild-kit/esm-loader": "npm:tsx@^4.21.0",
    "esbuild": "0.28.2",
    "js-yaml": "4.3.2"
  }
}
